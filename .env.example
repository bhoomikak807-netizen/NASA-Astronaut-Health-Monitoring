# ASTRA-SENTINEL AI — Environment Configuration Example

# Backend Server Port
PORT=8000
HOST=127.0.0.1

# NASA Open APIs
# Register free official key at: https://api.nasa.gov/
# Default fallback uses DEMO_KEY (with rate-limiting)
NASA_API_KEY=DEMO_KEY

# NASA FIRMS (Fire Information for Resource Management System)
# Request free MAP_KEY at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
NASA_FIRMS_MAP_KEY=

# Optional model-backed AstroHealth AI and FireHealth AI
# Create your own key in the OpenAI platform. Never expose it in frontend variables.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Production CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
